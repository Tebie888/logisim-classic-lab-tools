<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Minimal Logisim-HUST (classic Logisim 2.7) circuit used to verify the
  headless "-tty halt" mechanism.

  Verified behaviour (logisim-hust-20200118.exe, -tty table,halt):
      java -jar logisim-hust-20200118.exe -tty table,halt minimal-halt.circ
      => "halted due to halt pin"   (exit: sim halts immediately)

  Rules confirmed by experiment:
    * a Pin whose label is exactly "halt" is the halt control pin
    * that pin is removed from the printed value table
    * the simulation stops when its value becomes 1 (direction does not matter)
    * these single-port components have a port at loc; a wire segment
      covering the port connects it, even if an endpoint extends past it
    * multi-port components can have additional ports offset from loc
-->
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <circuit name="main">
    <comp lib="0" loc="(100,100)" name="Power">
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(200,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="halt"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(100,100)" to="(200,100)"/>
  </circuit>
</project>
